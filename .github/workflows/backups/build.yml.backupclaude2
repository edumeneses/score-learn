name: build

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: ruby/setup-ruby@v1
        with:
          ruby-version: "3.2"
          bundler-cache: true

      # Front matter, the 1400-1900 word reading budget, permalink stability,
      # the pinned score version, score files, re-verification notes, and every
      # internal lesson link against _data/units.yml.
      - name: Structural checks
        run: python3 scripts/check_lessons.py

      # Built with _local_config.yml so baseurl is empty, which is what
      # html-proofer needs to resolve links against the _site root.
      - name: Build the site
        run: bundle exec jekyll build --config _config.yml,_local_config.yml --trace

      # Links to /learn/ are validated by check_lessons.py against
      # _data/units.yml instead, because a forward reference to a lesson that is
      # planned but not yet written is expected while the course is in progress.
      - name: Check links
        run: |
          bundle exec htmlproofer _site \
            --disable-external \
            --allow-missing-href \
            --ignore-urls "/^\/learn\//"

      # The published config must also build, since it is what a deployment uses.
      - name: Build with the published config
        run: bundle exec jekyll build --trace
