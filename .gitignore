.jekyll-metadata
.vscode
# bundler's install path only. A bare `vendor` rule also swallowed the theme's
# _includes/vendor/, _layouts/vendor/, _sass/vendor/ and assets/js/vendor/,
# which broke the CI build while local builds kept working from disk.
/vendor/
*.gem
.bundle
.ruby-version
.jekyll-cache
.sass-cache
_site
Gemfile.lock
node_modules
.DS_Store

# editor-hook backups: same front matter, so they would shadow real pages
backups/
*.backupclaude*
__pycache__/
*.pyc
